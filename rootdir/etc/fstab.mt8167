# Android fstab file.
#<src>                                              <mnt_point>          <type>  <mnt_flags and options>                               <fs_mgr_flags>

/dev/block/platform/bootdevice/by-name/system       /system              ext4    ro                                                    wait
/dev/block/platform/bootdevice/by-name/vendor       /vendor              ext4    ro                                                    wait
/dev/block/platform/bootdevice/by-name/metadata     /metadata            ext4    noatime,nosuid,nodev,discard                          wait,check,formattable

/dev/block/platform/bootdevice/by-name/boot         /boot                emmc    defaults                                              defaults
/dev/block/platform/bootdevice/by-name/recovery     /recovery            emmc    defaults                                              defaults
/dev/block/platform/bootdevice/by-name/para         /misc                emmc    defaults                                              defaults
/dev/block/platform/bootdevice/by-name/dtbo         /dtbo                emmc    defaults                                              defaults
/dev/block/platform/bootdevice/by-name/logo         /logo                emmc    defaults                                              defaults

/dev/block/platform/bootdevice/by-name/userdata     /data                ext4    noatime,nosuid,nodev,noauto_da_alloc,discard          wait,check,encryptable=/dev/block/platform/bootdevice/by-name/metadata,latemount
/dev/block/platform/bootdevice/by-name/cache        /cache               ext4    noatime,nosuid,nodev,noauto_da_alloc,discard          wait,check

# MTK Specific mounts
/dev/block/platform/bootdevice/by-name/persist      /mnt/vendor/persist  ext4    nosuid,nodev,noatime                                  wait,check
/dev/block/platform/bootdevice/by-name/nvram        /nvram               emmc    defaults                                              defaults
/dev/block/platform/bootdevice/by-name/proinfo      /proinfo             emmc    defaults                                              defaults
/dev/block/platform/bootdevice/by-name/protect1     /protect_f           emmc    defaults                                              defaults
/dev/block/platform/bootdevice/by-name/protect2     /protect_s           emmc    defaults                                              defaults

# Removable storage
/devices/platform/soc/11130000.mmc*                 auto                 auto    defaults                                              voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb*                           auto                 auto    defaults                                              voldmanaged=usbotg:auto

# ZRAM
/dev/block/zram0                                    none                 swap    defaults                                              zramsize=75%,max_comp_streams=4
